# Copy to /etc/callassist-bridge.env, fill in, then: chmod 600 /etc/callassist-bridge.env
# Never commit the real file.

# CallAssist (public HTTPS URL) and the bridge's OAuth client secret
CALLASSIST_URL=https://d33lj83jn4hb7a.cloudfront.net
BRIDGE_CLIENT_ID=sip-bridge
BRIDGE_CLIENT_SECRET=

# Asterisk ARI (local only)
ARI_URL=http://127.0.0.1:8088
ARI_USER=callassist
ARI_PASS=

# Dial only through the test context (allowlist of consenting numbers)
DIAL_CONTEXT=callassist-test

# Audio folders (Asterisk must be able to read the first and write the second)
SOUNDS_DIR=/var/lib/asterisk/sounds/callassist
RECORDING_DIR=/var/spool/asterisk/recording

# Listening: stop recording after this much silence, or this long in total
MAX_SILENCE_SECONDS=2
MAX_REPLY_SECONDS=15
