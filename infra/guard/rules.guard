# Policy-as-code checks for CallAssist's CloudFormation (run with cfn-guard in CI).

let instances = Resources.*[ Type == 'AWS::EC2::Instance' ]
rule ec2_hardened when %instances !empty {
    # IMDSv2 only, and every disk encrypted
    %instances.Properties.MetadataOptions.HttpTokens == "required"
    %instances.Properties.BlockDeviceMappings[*].Ebs.Encrypted == true
}

let groups = Resources.*[ Type == 'AWS::EC2::SecurityGroup' ]
rule no_ssh_and_no_open_ingress when %groups !empty {
    %groups.Properties.SecurityGroupIngress[*] {
        FromPort != 22 <<SSH must stay closed: use Session Manager>>
        CidrIp not exists or CidrIp != "0.0.0.0/0" <<No ingress open to the whole internet>>
    }
}

let connect = Resources.*[ Type == 'AWS::Connect::Instance' ]
rule connect_instance_is_kept when %connect !empty {
    # AWS limits how often Connect instances can be created or deleted
    %connect.DeletionPolicy == "Retain"
    %connect.UpdateReplacePolicy == "Retain"
}

let repos = Resources.*[ Type == 'AWS::ECR::Repository' ]
rule images_scanned_and_immutable when %repos !empty {
    %repos.Properties.ImageScanningConfiguration.ScanOnPush == true
    %repos.Properties.ImageTagMutability == "IMMUTABLE"
}

let cdn = Resources.*[ Type == 'AWS::CloudFront::Distribution' ]
rule https_only when %cdn !empty {
    %cdn.Properties.DistributionConfig.DefaultCacheBehavior.ViewerProtocolPolicy in ["redirect-to-https", "https-only"]
}
